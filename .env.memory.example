# Fidus Memory - Environment Configuration
# Copy this file to .env.memory and configure for your setup

# =============================================================================
# LiteLLM Proxy Configuration
# =============================================================================
# All LLM requests go through your LiteLLM proxy server
# This allows centralized model management, caching, and fallbacks

# LiteLLM Proxy URL
# - Local: http://localhost:4000
# - Network: http://192.168.x.x:4000
OPENAI_API_BASE=http://localhost:4000

# Ollama API Base (for local embedding models)
# - Docker: http://ollama:11434
# - Local: http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# API Keys
# When using LiteLLM proxy, set OPENAI_API_KEY=LOCAL
# The actual keys are configured in the LiteLLM server
OPENAI_API_KEY=LOCAL
ANTHROPIC_API_KEY=

# =============================================================================
# Per-Agent LLM Models (all routed through LiteLLM proxy)
# =============================================================================
# Available models (see litellm_config.yaml):
#
# OpenAI GPT-4.1 Family:
#   - gpt-4.1        (Flagship, best for coding/agents)
#   - gpt-4.1-mini   (Fast, good instruction following)
#   - gpt-4.1-nano   (Ultrafast, structured output)
#
# OpenAI Reasoning:
#   - o4-mini        (Best reasoning, math/logic)
#   - o3-mini        (Enhanced reasoning)
#
# Anthropic Claude 4.5:
#   - claude-opus-4.5   (Flagship, long agentic tasks)
#   - claude-sonnet-4.5 (Best coding model)
#   - claude-haiku-4.5  (Fast, budget)
#
# Local (Ollama):
#   - llama3.3-70b-chat (Offline, privacy)
#   - qwen3-30b-chat    (Extended context)

# Default model for all agents (fallback)
FIDUS_LLM_MODEL=gpt-4.1-mini

# Chat Agent: Handles user conversations
# Recommended: gpt-4.1-mini, claude-haiku-4.5
FIDUS_CHAT_MODEL=gpt-4.1-mini

# Context Extraction: Extracts situational context from messages
# Recommended: gpt-4.1-nano (structured output, cheap)
FIDUS_CONTEXT_MODEL=gpt-4.1-nano

# Preference Learning: Learns and stores user preferences
# Recommended: gpt-4.1-mini, claude-haiku-4.5
FIDUS_PREFERENCE_MODEL=gpt-4.1-mini

# Reasoning: Complex reasoning tasks (math, logic)
# Recommended: o4-mini, o3-mini
FIDUS_REASONING_MODEL=o4-mini

# =============================================================================
# Embedding Configuration
# =============================================================================
# Embedding model for vector search
# Available: bge-m3, nomic-embed-text, openai/text-embedding-3-small
FIDUS_EMBEDDING_MODEL=bge-m3

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
